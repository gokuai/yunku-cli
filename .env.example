# Yunku CLI (ykc) 环境变量配置
# 复制本文件为 .env 并填入实际值

# 配置目录 (可选，默认 ~/.ykc)
# YKC_CONFIG_DIR=

# 缓存目录 (可选，默认 ~/.ykc/cache)
# YKC_CACHE_DIR=

# === 够快云库凭证 ===
# 开发授权凭证 (用于企业管理 ent 命令)
# 获取方式: 在够快企业管理后台创建开发授权
GOKUAI_CLIENT_ID=
GOKUAI_CLIENT_SECRET=

# API 主机地址 (可选，默认 https://yk3.gokuai.com)
# 私有化部署或测试环境可覆盖，不带协议头时自动补 https://
# GOKUAI_API_HOST=yk3.gokuai.com

# Passport 网页授权域名 (可选，默认 https://passport.gokuai.com)
# 用于 ykc auth login --browser 跳转的 OAuth2 登录页，私有化/测试环境与 GOKUAI_API_HOST 配合覆盖
# GOKUAI_PASSPORT_DOMAIN=passport.gokuai.com

# 库授权凭证 (用于企业库文件操作 ent file 命令)
# 获取方式二选一:
#   1. 自动绑定(推荐): 无需配置本项，执行 ent file 命令时传 --org-id 或 --mount-id，
#      CLI 用上面的企业凭证自动换取库授权并缓存 1 小时，期间后续命令可省略参数
#   2. 直接配置: 已有库授权凭证时取消注释填入，获取方式: 在够快企业管理后台创建对应库的开发授权
# GOKUAI_ORG_CLIENT_ID=
# GOKUAI_ORG_CLIENT_SECRET=


# 用户授权凭证 (用于文件 file/库 org 等用户 API 命令)
# 获取方式: 通过 ykc ent oauth get 获取，或手动填写
# 设置后可直接使用 ykc auth login 用户名密码登录，无需先调用 ent oauth get
GOKUAI_USER_CLIENT_ID=
GOKUAI_USER_CLIENT_SECRET=

# 浏览器 OAuth2 授权专用 client_id (仅 ykc auth login --browser 使用)
# 与上面的企业设备凭证、用户 SDK 凭证相互独立，浏览器登录不需要设备凭证、也不会调用 get_client_oauth
# 授权页只需 client_id，也可通过 --oauth-client-id 传入 (flag 优先)
# 服务端前提: 该 client 需开通 authorization_code + exchange_token 授权，并在 passport 的
# oauth_client_endpoints 中为用户所属站点登记 host 为 127.0.0.1 的回调地址 (仅校验 host，不校验端口/路径)
GOKUAI_OAUTH_CLIENT_ID=
# 浏览器登录第二步: passport 回跳的是短时效网页 token (约 300 秒)，CLI 会立即通过
# token2 接口的 exchange_token 授权 (auth=passport) 兑换成正式 token，兑换请求需用
# 下面的 GOKUAI_USER_CLIENT_SECRET 签名 (需与所用 client_id 配对)；
# 兑换成功后 client_id/secret 会一并保存到本地，后续命令无需再依赖环境变量

# 打开浏览器的命令 (可选，浏览器登录时使用，默认按平台调用 open/xdg-open/rundll32)
# 无图形界面 (SSH/CI/Docker) 时可设为 /bin/true 跳过自动打开，CLI 会把授权地址打印到终端
# BROWSER=/bin/true

# Bearer Token 认证 (可选，等同全局参数 --bearer-token，flag 优先)
# 设置后用户 API 命令跳过签名，直接使用该 token 认证
# GOKUAI_BEARER_TOKEN=
